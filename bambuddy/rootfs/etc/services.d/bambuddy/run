#!/usr/bin/with-contenv bashio
# shellcheck shell=bash


LOG_LEVEL=$(bashio::config 'log_level')
export LOG_LEVEL="${LOG_LEVEL:-info}"

# Home Assistant integration.
# If ha_url/ha_token are not set, fall back to the Supervisor's internal
# Core API proxy (available because homeassistant_api: true in config.yaml
# makes the Supervisor inject SUPERVISOR_TOKEN into this container).
if bashio::config.has_value 'ha_url'; then
    HA_URL=$(bashio::config 'ha_url')
else
    HA_URL="http://supervisor/core"
fi
export HA_URL
bashio::log.info "Home Assistant URL: ${HA_URL}"

if bashio::config.has_value 'ha_token'; then
    HA_TOKEN=$(bashio::config 'ha_token')
else
    HA_TOKEN="${SUPERVISOR_TOKEN}"
fi
export HA_TOKEN

HA_INFO_RESPONSE=$(curl --silent --fail --max-time 5 \
  --header "Authorization: Bearer ${HA_TOKEN}" \
  "${HA_URL%/core}/info" 2>/dev/null) || true

TZ=""
if [ -n "${HA_INFO_RESPONSE}" ]; then
    TZ=$(bashio::jq "${HA_INFO_RESPONSE}" '.data.timezone // empty')
fi
export TZ="${TZ:-UTC}"
bashio::log.info "Timezone: ${TZ}"

if bashio::config.has_value 'bind_address'; then
    BIND_ADDRESS=$(bashio::config 'bind_address')
    export BIND_ADDRESS="${BIND_ADDRESS}"
    bashio::log.info "Binding to: ${BIND_ADDRESS}"
fi

mkdir -p /data/bambuddy_data /data/bambuddy_logs

if [ ! -L /app/data ]; then
    rm -rf /app/data
    ln -s /data/bambuddy_data /app/data
fi
if [ ! -L /app/logs ]; then
    rm -rf /app/logs
    ln -s /data/bambuddy_logs /app/logs
fi

# Redirect BamBuddy's internal backup folder to /share/bambuddy_backups so it
# isn't duplicated inside Home Assistant's own App backups (which snapshot
# the entire persistent data volume) -- without this, every HA backup would
# also contain every BamBuddy backup made since, growing without bound.
mkdir -p /share/bambuddy_backups
if [ ! -L /app/data/backups ]; then
    MIGRATION_FAILED=0
    if [ -d /app/data/backups ] && [ -n "$(ls -A /app/data/backups 2>/dev/null)" ]; then
        bashio::log.info "Migrating existing BamBuddy backups to /share/bambuddy_backups"
        # Plain "cp -a" per file (no -n/--update, not portable on BusyBox/Alpine);
        # files already present at the destination are left untouched.
        for f in /app/data/backups/*; do
            [ -e "${f}" ] || continue
            dest="/share/bambuddy_backups/$(basename "${f}")"
            if [ ! -e "${dest}" ]; then
                cp -a "${f}" "${dest}" || MIGRATION_FAILED=1
            fi
        done
        # Verify every source file has a counterpart before deleting anything.
        for f in /app/data/backups/*; do
            [ -e "${f}" ] || continue
            [ -e "/share/bambuddy_backups/$(basename "${f}")" ] || MIGRATION_FAILED=1
        done
    fi
    if [ "${MIGRATION_FAILED}" = 1 ]; then
        # Never delete originals we couldn't confirm were copied.
        mv /app/data/backups /app/data/backups.not-migrated
        bashio::log.error "Backup migration incomplete -- originals kept as backups.not-migrated"
        bashio::log.error "Compare them against /share/bambuddy_backups, then delete that folder manually."
    else
        rm -rf /app/data/backups
    fi
    ln -s /share/bambuddy_backups /app/data/backups
    bashio::log.info "BamBuddy backups now stored in /share/bambuddy_backups"
fi

# Fix finish permissions at runtime
chmod +x /etc/services.d/bambuddy/finish 2>/dev/null || true

if bashio::config.has_value 'trusted_frame_origins'; then
    TRUSTED_FRAME_ORIGINS=$(bashio::jq "/data/options.json" '.trusted_frame_origins // [] | join(",")')
    if [ -n "${TRUSTED_FRAME_ORIGINS}" ]; then
        export TRUSTED_FRAME_ORIGINS
        bashio::log.info "Trusted frame origins: ${TRUSTED_FRAME_ORIGINS}"
    fi
fi

if bashio::config.has_value 'database_url'; then
    DATABASE_URL=$(bashio::config 'database_url')
    export DATABASE_URL="${DATABASE_URL}"
    bashio::log.info "Using external PostgreSQL database"
fi

# External storage (Share / Media). Mounted via config.yaml (share:rw, media:rw).
# share_subfolder/media_subfolder scope BamBuddy's access to a specific
# subfolder instead of the whole /share or /media tree, so it doesn't see
# files belonging to other Apps. Leave unset to disable; leave set to "" is
# treated as unset (no root granted) -- there is no "expose the whole
# folder" option anymore, on purpose.
sanitize_subfolder() {
    # Strip leading/trailing slashes and reject any ".." path segment.
    # $2 is the root name ("share" or "media"), used only to warn if the
    # user redundantly typed it as a prefix (e.g. "/share/bambuddy" instead
    # of just "bambuddy").
    local raw="$1"
    local root_name="$2"
    local clean="${raw#/}"
    clean="${clean%/}"
    if [[ "${clean}" == *".."* ]]; then
        bashio::log.warning "Ignoring ${root_name}_subfolder value with '..': ${raw}"
        echo ""
        return
    fi
    if [[ "${clean}" == "${root_name}/"* ]] || [[ "${clean}" == "${root_name}" ]]; then
        bashio::log.warning "${root_name}_subfolder should not include '${root_name}/' -- did you mean '${clean#"${root_name}"/}'? Using the value as given."
    fi
    echo "${clean}"
}

EXTERNAL_ROOTS=""
if bashio::config.has_value 'share_subfolder'; then
    SHARE_SUB=$(sanitize_subfolder "$(bashio::config 'share_subfolder')" "share")
    if [ -n "${SHARE_SUB}" ]; then
        mkdir -p "/share/${SHARE_SUB}"
        bashio::log.info "Enabling /share/${SHARE_SUB} as external root"
        EXTERNAL_ROOTS="/share/${SHARE_SUB}"
    fi
fi
if bashio::config.has_value 'media_subfolder'; then
    MEDIA_SUB=$(sanitize_subfolder "$(bashio::config 'media_subfolder')" "media")
    if [ -n "${MEDIA_SUB}" ]; then
        mkdir -p "/media/${MEDIA_SUB}"
        bashio::log.info "Enabling /media/${MEDIA_SUB} as external root"
        if [ -n "${EXTERNAL_ROOTS}" ]; then
            EXTERNAL_ROOTS="${EXTERNAL_ROOTS}:/media/${MEDIA_SUB}"
        else
            EXTERNAL_ROOTS="/media/${MEDIA_SUB}"
        fi
    fi
fi
if [ -n "${EXTERNAL_ROOTS}" ]; then
    export BAMBUDDY_EXTERNAL_ROOTS="${EXTERNAL_ROOTS}"
    bashio::log.info "External roots: ${EXTERNAL_ROOTS}"
fi

if bashio::config.true 'use_system_trust_store'; then
    CERTFILE=$(bashio::config 'certfile')
    if [ "${CERTFILE}" = "null" ]; then
        CERTFILE=""
    fi
    CERT_SRC="/config/${CERTFILE}"
    if [ -n "${CERTFILE}" ] && [ -f "${CERT_SRC}" ]; then
        bashio::log.info "Installing CA certificate: ${CERTFILE}"
        cp "${CERT_SRC}" "/usr/local/share/ca-certificates/${CERTFILE}"
        update-ca-certificates
        export USE_SYSTEM_TRUST_STORE="true"
        bashio::log.info "System trust store enabled"
    else
        bashio::log.warning "use_system_trust_store is enabled but no valid certificate filename/file was found."
        bashio::log.warning "Set 'certfile' to a filename and place that CA certificate (.crt) in the addon_configs folder."
    fi
fi

export PORT=8000
export PYTHONPATH=/app
export PYTHONUNBUFFERED=1

# IPv6 is opt-in and off by default: binding uvicorn on :: has been observed
# to stop accepting IPv4 connections entirely on some systems, even with
# net.ipv6.bindv6only=0 at the kernel level -- this is a uvicorn/asyncio
# socket behavior, not something we can detect or guard against from here.
BIND_HOST="0.0.0.0"
if bashio::config.true 'enable_ipv6'; then
    bashio::log.warning "IPv6 enabled -- binding on :: instead of 0.0.0.0."
    bashio::log.warning "If BamBuddy becomes unreachable after this, disable"
    bashio::log.warning "'Enable IPv6' in the add-on configuration and restart."
    BIND_HOST="::"
fi

bashio::log.info "Starting BamBuddy on port ${PORT}..."

cd /app || bashio::exit.nok "Cannot cd to /app"
exec python3 -m uvicorn backend.app.main:app \
    --host "${BIND_HOST}" \
    --port "${PORT}" \
    --loop asyncio